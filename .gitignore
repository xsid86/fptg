# Settings and accounts — the encrypted file (secureconfig.pas) and its
# temporary/deferred copies; config.ini/accounts.ini — the former plain ones.
# For both programs (the server — accounts, the window — the connection).
conf.dat
conf.dat.tmp
conf.dat.unreadable
config.ini
accounts.ini
tdlib/
tdlib_raw.log
# Files the page uploads for sending (localserver /upload); cleared at start.
uploads/
fptg-client/web/.idea/
fptg-client/web/assets/scss/*.css.map

# The single instance (instance.pas): the lock and the channel's port/key.
*.lock
*.instance

# Build output: rebuilt by lazbuild, 50 MB per copy in history.
fptg-client.exe
fptg.dbg
fptg-server.exe
fptg-server.dbg
fptg-server-gui.exe
fptg-server-gui.dbg
lib/

# Lazarus/lazbuild backups of edited project files.
backup/

# The paid multi-user part of the server — closed, it does not go into the
# public repository (a private repository of its own).
fptg-server-premium/

# Release archives (tools/build_release.py).
dist/

# The project website lives outside this repository.
website/

# Server data next to its exe (appdirs.pas): sessions, settings, files.
fptg-server/data/
