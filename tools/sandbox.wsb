<!-- A clean Windows for checking a release (Windows Sandbox, Windows 10/11 Pro).
     Open with a double click. The project's dist\ folder is visible inside on
     the desktop, read-only: unpack the archives from there into any folder.
     Networking is on: a server inside the sandbox is reachable from this
     machine at the sandbox's address (ipconfig inside), a client inside
     connects to a server on this machine or on a VPS at its external address. -->
<Configuration>
  <MappedFolders>
    <MappedFolder>
      <HostFolder>I:\Apps\fptelegram\dist</HostFolder>
      <SandboxFolder>C:\Users\WDAGUtilityAccount\Desktop\dist</SandboxFolder>
      <ReadOnly>true</ReadOnly>
    </MappedFolder>
  </MappedFolders>
  <Networking>Enable</Networking>
  <LogonCommand>
    <Command>explorer.exe C:\Users\WDAGUtilityAccount\Desktop\dist</Command>
  </LogonCommand>
</Configuration>
