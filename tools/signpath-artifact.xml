<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration for the "Release" workflow
     (.github/workflows/release.yml): the uploaded artifact is a zip with
     the three programs in their project folders. Paste it into SignPath:
     project fptg → Artifact configurations. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <zip-file>
    <directory path="fptg-server">
      <pe-file path="fptg-server.exe">
        <authenticode-sign/>
      </pe-file>
      <pe-file path="fptg-server-gui.exe">
        <authenticode-sign/>
      </pe-file>
    </directory>
    <directory path="fptg-client">
      <pe-file path="fptg-client.exe">
        <authenticode-sign/>
      </pe-file>
    </directory>
  </zip-file>
</artifact-configuration>
