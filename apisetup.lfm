object FormApiConfig: TFormApiConfig
  Left = 0
  Height = 300
  Top = 0
  Width = 460
  BorderIcons = [biSystemMenu]
  BorderStyle = bsDialog
  Caption = 'Telegram API credentials'
  ClientHeight = 300
  ClientWidth = 460
  Position = poScreenCenter
  OnCreate = FormCreate
  OnShow = FormShow
  object lblTitle: TLabel
    Left = 16
    Height = 21
    Top = 16
    Width = 428
    Caption = 'Telegram API credentials required'
    Font.Style = [fsBold]
    ParentFont = False
  end
  object lblInfo: TLabel
    Left = 16
    Height = 48
    Top = 44
    Width = 428
    AutoSize = False
    Caption = 'This app needs an api_id/api_hash pair issued by Telegram to connect — one is required to talk to Telegram''s servers at all, and it is free. Get one at my.telegram.org (API development tools), then paste both values below.'
    WordWrap = True
  end
  object lblLink: TLabel
    Left = 16
    Height = 15
    Top = 96
    Width = 143
    Caption = 'https://my.telegram.org'
    Cursor = crHandPoint
    Font.Color = clBlue
    Font.Style = [fsUnderline]
    ParentFont = False
    OnClick = lblLinkClick
  end
  object lblApiId: TLabel
    Left = 16
    Height = 15
    Top = 128
    Width = 43
    Caption = 'API ID:'
  end
  object edtApiId: TEdit
    Left = 16
    Height = 23
    Top = 146
    Width = 200
    TabOrder = 0
    OnKeyPress = edtApiIdKeyPress
  end
  object lblApiHash: TLabel
    Left = 16
    Height = 15
    Top = 180
    Width = 58
    Caption = 'API hash:'
  end
  object edtApiHash: TEdit
    Left = 16
    Height = 23
    Top = 198
    Width = 428
    TabOrder = 1
  end
  object btnOk: TButton
    Left = 344
    Height = 27
    Top = 240
    Width = 100
    Caption = 'Continue'
    Default = True
    TabOrder = 2
    OnClick = btnOkClick
  end
  object btnCancel: TButton
    Left = 236
    Height = 27
    Top = 240
    Width = 100
    Cancel = True
    Caption = 'Quit'
    ModalResult = 2
    TabOrder = 3
  end
end
