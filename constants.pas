  ICON_QUOTE        = 11;

  BADGE_H  = 18;
  BADGE_PAD = 7;
  BADGE_FONT_H = 12;
  BADGE_CACHE_MAX = 64;
  { Отметка о прочтении — те же самые "галочки", что и раньше
