object FrameSettingsGeneral: TFrameSettingsGeneral
  Left = 0
  Height = 300
  Top = 0
  Width = 400
  ClientHeight = 300
  ClientWidth = 400
  TabOrder = 0
  object chkCloseToTray: TCheckBox
    Left = 16
    Height = 19
    Top = 16
    Width = 200
    Caption = 'Close to tray instead of quitting'
    TabOrder = 0
    OnChange = chkCloseToTrayChange
  end
  object lblDeviceModel: TLabel
    Left = 16
    Height = 15
    Top = 56
    Width = 200
    Caption = 'Device name (Telegram > Active Sessions)'
  end
  object edtDeviceModel: TEdit
    Left = 16
    Height = 23
    Top = 76
    Width = 200
    TabOrder = 1
    OnExit = edtDeviceModelExit
  end
  object lblAccentColor: TLabel
    Left = 16
    Height = 15
    Top = 116
    Width = 200
    Caption = 'App accent color'
  end
  object cbAccentColor: TColorBox
    Left = 16
    Height = 23
    Top = 136
    Width = 200
    Style = [cbStandardColors, cbExtendedColors, cbCustomColor, cbPrettyNames]
    ItemHeight = 16
    TabOrder = 2
    OnChange = cbAccentColorChange
  end
end
