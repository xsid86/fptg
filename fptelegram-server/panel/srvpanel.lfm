    object lblClTraffic: TLabel
      Left = 12
      Height = 15
      Top = 26
      Width = 296
      Anchors = [akTop, akLeft, akRight]
      AutoSize = False
      Caption = 'Clients  -'
    end
  end
  object trayIcon: TTrayIcon
    PopUpMenu = popTray
    Hint = 'FPTelegram server'
    OnDblClick = miShowClick
    Left = 248
    Top = 64
  end
  object popTray: TPopupMenu
    Left = 248
    Top = 112
    object miShow: TMenuItem
      Caption = 'Show window'
      Default = True
      OnClick = miShowClick
    end
    object miStartStop: TMenuItem
      Caption = 'Start server'
      OnClick = btnStartStopClick
    end
    object miSeparator: TMenuItem
      Caption = '-'
    end
    object miQuit: TMenuItem
      Caption = 'Quit'
      OnClick = miQuitClick
    end
  end
  object tmrGiveUp: TTimer
    Enabled = False
    OnTimer = tmrGiveUpTimer
    Left = 248
    Top = 160
  end
  object tmrPoll: TTimer
    Enabled = False
    Interval = 2000
    OnTimer = tmrPollTimer
    Left = 248
    Top = 208
  end
  object tmrTraffic: TTimer
    Enabled = False
    Interval = 1000
    OnTimer = tmrTrafficTimer
    Left = 248
    Top = 256
  end
end
