  end
  object btnSignOut: TButton
    Left = 12
    Height = 30
    Top = 281
    Width = 296
    Anchors = [akTop, akLeft, akRight]
    Caption = 'Sign out'
    TabOrder = 6
    OnClick = btnSignOutClick
  end
  object pnlTraffic: TPanel
    Left = 0
    Height = 48
    Top = 323
    Width = 320
    Align = alBottom
    BevelOuter = bvNone
    ClientHeight = 48
    ClientWidth = 320
    TabOrder = 9
    TabStop = False
    object bvlTraffic: TBevel
      Left = 0
      Height = 2
      Top = 0
      Width = 320
      Align = alTop
      Shape = bsTopLine
    end
    object lblTgTraffic: TLabel
      Left = 12
      Height = 15
      Top = 8
      Width = 296
      Anchors = [akTop, akLeft, akRight]
