object FormServerPanel: TFormServerPanel
  Left = 400
  Height = 371
  Top = 200
  Width = 320
  BorderIcons = [biSystemMenu, biMinimize]
  BorderStyle = bsSingle
  Caption = 'FPTelegram server'
  ClientHeight = 371
  ClientWidth = 320
  Position = poScreenCenter
  ShowInTaskBar = stAlways
  OnCloseQuery = FormCloseQuery
  OnCreate = FormCreate
  OnDestroy = FormDestroy
  LCLVersion = '4.8.0.0'
  object lblStatus: TLabel
    Left = 12
    Height = 15
    Top = 12
    Width = 48
    Caption = 'Stopped'
    Font.Style = [fsBold]
    ParentFont = False
  end
  object lblUrl: TLabel
    AnchorSideLeft.Control = lblStatus
    AnchorSideLeft.Side = asrBottom
    AnchorSideTop.Control = lblStatus
    Cursor = crHandPoint
    Left = 64
    Height = 15
    Top = 12
    Width = 1
    BorderSpacing.Left = 4
    Font.Color = clHotLight
    Font.Style = [fsBold, fsUnderline]
    Hint = 'Open in the browser'
    ParentFont = False
    ParentShowHint = False
    ShowHint = True
    Visible = False
    OnClick = lblUrlClick
  end
  object btnStartStop: TButton
    Left = 12
    Height = 30
    Top = 34
    Width = 296
    Anchors = [akTop, akLeft, akRight]
    Caption = 'Start'
    TabOrder = 0
    OnClick = btnStartStopClick
  end
  object lblAddress: TLabel
    Left = 12
    Height = 15
    Top = 76
    Width = 42
    Caption = 'Address'
  end
  object edtAddress: TEdit
    Left = 12
    Height = 23
    Top = 94
    Width = 222
    Anchors = [akTop, akLeft, akRight]
    ReadOnly = True
    TabStop = False
    TabOrder = 1
  end
  object btnCopyAddress: TButton
    Left = 240
    Height = 23
    Top = 94
    Width = 68
    Anchors = [akTop, akRight]
    Caption = 'Copy'
    TabOrder = 7
    OnClick = btnCopyAddressClick
  end
  object lblPort: TLabel
    Left = 12
    Height = 15
    Top = 125
    Width = 22
    Caption = 'Port'
  end
  object edtPort: TEdit
    Left = 12
    Height = 23
    Top = 143
    Width = 222
    Anchors = [akTop, akLeft, akRight]
    MaxLength = 5
    NumbersOnly = True
    TabOrder = 2
  end
  object btnCopyPort: TButton
    Left = 240
    Height = 23
    Top = 143
    Width = 68
    Anchors = [akTop, akRight]
    Caption = 'Copy'
    TabOrder = 8
    OnClick = btnCopyPortClick
  end
  object lblPrint: TLabel
    Left = 12
    Height = 15
    Top = 174
    Width = 186
    Caption = 'Certificate fingerprint (SHA-256)'
  end
  object edtPrint: TEdit
    Left = 12
    Height = 23
    Top = 192
    Width = 296
    Anchors = [akTop, akLeft, akRight]
    ReadOnly = True
    TabStop = False
    TabOrder = 3
  end
  object lblUser: TLabel
    Left = 12
    Height = 15
    Top = 228
    Width = 26
    Caption = 'User'
  end
  object edtUser: TEdit
    Left = 12
    Height = 23
    Top = 246
    Width = 222
    Anchors = [akTop, akLeft, akRight]
    ReadOnly = True
    TabStop = False
    TabOrder = 4
  end
  object btnUser: TButton
    Left = 240
    Height = 23
    Top = 246
    Width = 68
    Anchors = [akTop, akRight]
    Caption = 'Change...'
    TabOrder = 5
